<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('C:\Program Files (x86)\Teradyne\UltraEdge\UltraEdge.dll')">
    <DefineConstants>$(DefineConstants);HAS_ULTRAEDGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Program.cs" Link="Program.cs" />
    <Compile Include="..\UEProxy.cs" Link="UEProxy.cs" />
    <Compile Include="..\UETools.cs" Link="UETools.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <UltraEdgeDllPath>C:\Program Files (x86)\Teradyne\UltraEdge\UltraEdge.dll</UltraEdgeDllPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(UltraEdgeDllPath)')">
    <Reference Include="UltraEdge">
      <HintPath>$(UltraEdgeDllPath)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
